{
  "name": "subletka",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "worker": "cp node_modules/maplibre-gl/dist/maplibre-gl-worker.mjs public/",
    "predev": "npm run worker",
    "dev": "next dev",
    "prebuild": "npm run worker",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test": "node --conditions=react-server --import tsx --test src/**/*.test.ts",
    "test:ci": "node --conditions=react-server --import tsx --test --test-concurrency=1 src/**/*.test.ts",
    "seed": "node --env-file-if-exists=.env.local --conditions=react-server --import tsx scripts/seed.ts",
    "typecheck": "next typegen && tsc --noEmit"
  },
  "dependencies": {
    "@base-ui/react": "^1.9.0",
    "class-variance-authority": "^0.7.1",
